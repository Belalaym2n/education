# .env.example
APP_ENV=development
APP_DEBUG=true
APP_URL=

DB_DRIVER=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET=
JWT_EXPIRY=3600

RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

LOG_LEVEL=debug 
# Firebase Cloud Messaging (HTTP v1)
# Project that the mobile apps are registered in.
FIREBASE_PROJECT_ID=
# Absolute path to the service-account JSON, OUTSIDE the web root
# (e.g. D:/secrets/education-fcm.json). Never commit this file.
FIREBASE_CREDENTIALS_PATH=
